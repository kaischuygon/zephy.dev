---
import type { CollectionEntry } from "astro:content";
import CollectionCard from "./CollectionCard.astro";

interface Props {
    item: CollectionEntry<"portfolio">;
}

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/*.{jpeg,jpg,png,gif}",
);
const { item } = Astro.props as Props;
const imgSrc = images[item.data.img] ?? item.data.img;

const link = `/portfolio/${item.id}`;
---

<CollectionCard
    href={link}
    title={item.data.title}
    media={{
        type: "image",
        src: typeof imgSrc === "function" ? imgSrc() : imgSrc,
        alt: item.data.img_alt,
    }}
    descriptionClampLines={3}
>
    <span slot="subtitle" class="text-xs font-light">
        {item.data.tags.join(" • ")}
    </span>
    <p slot="description">{item.data.description}</p>
</CollectionCard>
