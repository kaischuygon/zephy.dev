---
import type { CollectionEntry } from "astro:content";
import { getPostTags } from "../utils/blogTags";
import CollectionCard from "./CollectionCard.astro";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props as Props;

const link = `/blog/${post.id}`;
const tags = getPostTags(post);
---

<CollectionCard
    href={link}
    title={post.data.title ?? "Untitled post"}
    descriptionClampLines={2}
>
    <span slot="subtitle" class="text-xs font-light">
        {post.data.pubDate?.toLocaleDateString()}
    </span>
    {
        tags.length > 0 && (
            <div
                slot="tags"
                class="flex flex-wrap gap-1 text-xs wrap-break-word whitespace-normal italic"
            >
                {tags.join(" • ")}
            </div>
        )
    }
    <p slot="description">{post.data.description}</p>
</CollectionCard>
