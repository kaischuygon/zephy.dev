---
import { getCollection } from "astro:content";
import Post from "./Post.astro";
import PostsFilter from "./PostsFilter";
import ViewAllLink from "./ViewAllLink.astro";
import { getPostTags, getTagSlug } from "../utils/blogTags";

interface Props {
    count?: number;
    ignore_ids?: string[];
    enableTagFilter?: boolean;
    enableDateFilter?: boolean;
    /** Restricts to posts published in this year/month — used by the
     * /blog/[year] and /blog/[year]/[month] archive routes. month is
     * unpadded (1-12), matching pubDate.getMonth() + 1 and the
     * data-month/?month= convention PostsFilter already uses. */
    year?: number;
    month?: number;
    heading?: string;
}

const {
    count = -1,
    ignore_ids = [],
    enableTagFilter = false,
    enableDateFilter = false,
    year,
    month,
    heading = "",
} = Astro.props as Props;

const posts = (await getCollection("blog"))
    .filter((post) => (ignore_ids ? !ignore_ids.includes(post.id) : post))
    .filter((post) => !post.data.isDraft)
    .filter((post) => !year || post.data.pubDate.getFullYear() === year)
    .filter(
        (post) => !month || post.data.pubDate.getMonth() + 1 === month,
    )
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, count === -1 ? undefined : count);

const postCards = posts.map((post) => {
    const tags = getPostTags(post);
    const postYear = post.data.pubDate.getFullYear();
    const postMonth = post.data.pubDate.getMonth() + 1;

    return {
        post,
        tags,
        tagSlugs: tags.map(getTagSlug),
        year: postYear,
        month: postMonth,
    };
});

const availableYears = [
    ...new Set(postCards.map((postCard) => postCard.year)),
].sort((a, b) => b - a);

// Count tag frequency
const tagFrequency = new Map<string, { label: string; count: number }>();
for (const postCard of postCards) {
    postCard.tagSlugs.forEach((slug, index) => {
        const label = postCard.tags[index] ?? slug;
        if (!tagFrequency.has(slug)) {
            tagFrequency.set(slug, { label, count: 1 });
        } else {
            tagFrequency.get(slug)!.count++;
        }
    });
}

const availableTags = [...tagFrequency.entries()]
    .map(([slug, { label, count }]) => ({ slug, label, count }))
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const TOP_TAG_COUNT = 10;
---

<section data-posts-root>
    {
        (enableTagFilter || enableDateFilter) && (
            <PostsFilter
                client:load
                availableTags={enableTagFilter ? availableTags : []}
                availableYears={enableDateFilter ? availableYears : []}
                topTagCount={TOP_TAG_COUNT}
            />
        )
    }

    {postCards.length > 0 && (
        <section class="w-full">
            <h2 class="mb-2 text-2xl font-semibold">{heading}</h2>
            <div class="grid gap-4 grid-cols-1" data-post-list>
                {
                    postCards.map((postCard) => (
                        <div
                            data-post-card
                            data-tags={postCard.tagSlugs.join(" ")}
                            data-year={String(postCard.year)}
                            data-month={String(postCard.month)}
                            class="h-full"
                        >
                            <Post post={postCard.post} />
                        </div>
                    ))
                }
            </div>
        </section>
    )}

    {count >= posts.length && <ViewAllLink href="/blog" label="view all posts" />}
</section>
