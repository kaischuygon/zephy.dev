---
import { Icon } from "astro-icon/components";
import Search from "astro-pagefind/components/Search.astro";
---

<button id="searchButton" title="Search"
    ><kbd title="press s to search">s</kbd>earch</button
>

<dialog
    id="searchDialog"
    closedby="any"
    class="bg-surface-50 text-surface-900 rounded-theme dark:bg-surface-950 dark:text-surface-50 absolute mx-auto mt-8 max-h-[90vh] w-sm max-w-11/12 overflow-scroll"
>
    <search class="flex flex-col gap-2 p-4">
        <div class="flex items-center justify-between gap-2">
            <h2 class="font-semibold">Search</h2>
            <Icon
                name="lineicons:xmark"
                role="button"
                id="closeButton"
                class="clickable ml-auto text-2xl"
            />
        </div>
        <Search
            configOptions={{ showImages: false, id: "search" }}
            searchboxOptions={{ showImages: false }}
        />
    </search>
</dialog>

<style is:inline>
    /* body, not :root — theme-recipes.css scopes its overrides
       (--radius-theme, --color-accent, --font-sans) to
       [data-section="recipes"], which Layout.astro sets on <body>. :root is
       <html>, an ancestor of that, so computing these derived --pf-* tokens
       there would only ever see the site-wide defaults and never the
       recipes-section override — same reasoning as .surface-prose already
       relies on, just one level up. */
    body {
        --pf-text: light-dark(
            var(--color-surface-900),
            var(--color-surface-50)
        );
        --pf-text-secondary: light-dark(
            var(--color-surface-600),
            var(--color-surface-400)
        );
        --pf-text-muted: light-dark(
            var(--color-surface-500),
            var(--color-surface-400)
        );
        --pf-background: light-dark(
            var(--color-surface-50),
            var(--color-surface-950)
        );
        --pf-hover: light-dark(
            var(--color-surface-100),
            var(--color-surface-900)
        );
        --pf-skeleton: light-dark(
            var(--color-surface-200),
            var(--color-surface-800)
        );
        --pf-skeleton-shine: light-dark(
            var(--color-surface-100),
            var(--color-surface-700)
        );
        --pf-border: var(--color-accent);
        --pf-border-focus: var(--color-accent);
        --pf-mark: var(--color-accent);
        --pf-outline-focus: var(--color-accent);
        --pf-font: var(--font-sans);
        --pf-border-radius: var(--radius-theme);
    }

    /* Render results inline under the search box instead of the library's
       default floating/absolutely-positioned dropdown — this modal is
       already a small popover, so a second overlay on top of it reads as
       cramped rather than useful. The component-ui stylesheet deliberately
       boosts its own selectors' specificity to resist exactly this kind of
       override (see the :is(*, #\#) comment at the top of
       node_modules/@pagefind/component-ui/css/pagefind-component-ui.css),
       so !important is the sanctioned escape hatch here, not a shortcut
       around a normal override. Only `position` needs to change — display
       toggling (`.pf-searchbox.open .pf-searchbox-dropdown`) and the rest
       of the box styling are left alone. */
    .pf-searchbox-dropdown {
        position: static !important;
        box-shadow: none !important;
    }
</style>

<script is:inline>
    const searchButton = document.getElementById("searchButton");
    const searchDialog = document.getElementById("searchDialog");
    const closeBtn = document.getElementById("closeButton");

    // searchDialog.showModal();

    searchButton.addEventListener("click", (e) => {
        e.preventDefault();
        searchDialog.showModal();
    });

    closeBtn.addEventListener("click", (e) => {
        e.preventDefault();
        searchDialog.close();
    });

    searchDialog.addEventListener("toggle", (e) => {
        e.preventDefault();
        if (e.newState === "open") {
            document.body.classList.add("overflow-hidden");
        } else {
            document.body.classList.remove("overflow-hidden");
        }
    });

    document.addEventListener("keypress", (e) => {
        switch (e.key) {
            case "s":
                searchButton.click();
                break;
            default:
                break;
        }
    });
</script>
