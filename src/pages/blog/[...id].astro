---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Posts from "../../components/Posts.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { getPostTags, getTagSlug } from "../../utils/blogTags";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
    const posts = await getCollection("blog");
    const publishedPosts = posts.filter((post) => !post.data.isDraft);

    return publishedPosts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);
const tags = getPostTags(post);

const year = post.data.pubDate.getFullYear();
const month = post.data.pubDate.getMonth() + 1;
const breadcrumbItems = [
    { label: "Home", href: "/" },
    { label: "Blog", href: "/blog" },
    { label: String(year), href: `/blog/${year}` },
    {
        label: post.data.pubDate.toLocaleDateString(undefined, {
            month: "long",
        }),
        href: `/blog/${year}/${month}`,
    },
    { label: post.data.title ?? "Untitled post" },
];
---

<ArticleLayout collectionItem={post} breadcrumbItems={breadcrumbItems}>
    <h4 class="my-4 font-light">
        {post.data.pubDate?.toLocaleDateString()}
    </h4>
    <h1 data-pagefind-meta="title">
        {post.data.title}
    </h1>
    <div class="not-prose mb-2 flex flex-wrap gap-2">
        {
            tags.map((tag) => (
                <a
                    href={`/blog?tag=${encodeURIComponent(getTagSlug(tag))}`}
                    class="btn px-1 py-0"
                >
                    {tag}
                </a>
            ))
        }
    </div>
    <Content />

    <Fragment slot="related">
        {post.data.related && <RelatedPosts item={post} />}
        <Posts
            count={3}
            ignore_ids={[
                ...(post.data.related?.map((r) => r.id) || []),
                post.id,
            ]}
            heading="More posts"
        />
    </Fragment>
</ArticleLayout>
