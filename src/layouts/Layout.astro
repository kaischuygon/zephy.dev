---
import type { CollectionEntry } from "astro:content";
import { SEO } from "astro-seo";
import { Icon } from "astro-icon/components";

import "../styles/global.css";
import Footer from "../components/Footer.astro";
import SocialLinks from "../components/SocialLinks.astro";
import ThemeSelect from "../components/ThemeSelect";
import AccentSelect from "../components/AccentSelect";
import SurfaceSelect from "../components/SurfaceSelect";
import SearchModal from "../components/SearchModal.astro";
import SideNav from "../components/SideNav.astro";

import accentColors from "../content/accent-colors.json";
import surfaceColors from "../content/surface-colors.json";

interface Props {
    title?: string;
    description?: string;
    collectionItem?:
        | CollectionEntry<"blog">
        | CollectionEntry<"portfolio">
        | CollectionEntry<"recipes">;
    /** Opts into a section-specific theme (see src/styles/theme-recipes.css).
     * Applied as data-section on <body>; also locks data-surface to
     * "taupe" (see src/styles/surfaces.css) regardless of the site-wide
     * surface pick. */
    section?: "recipes";
}

const { title, description, collectionItem, section } = Astro.props;

const author = "Kai Schuyler Gonzalez";
const getTitle =
    (collectionItem?.data.title ?? title ?? "zephy.dev") + " | " + author;

const generalDescription =
    "Personal portfolio site of Kai Schuyler Gonzalez, a software engineer / designer based in Denver, CO.";

const getDescription =
    description ?? collectionItem?.data.description ?? generalDescription;

const getImage = collectionItem?.data.img || "/og-image.png";
---

<!doctype html>
<html lang="en" class="scheme-light dark:scheme-dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="light dark" />
        <meta name="generator" content={Astro.generator} />
        <title>{getTitle}</title>
        <meta name="author" content={author} />

        <!-- Structured Data for SEO -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Kai Schuyler Gonzalez",
                "url": "https://zephy.dev",
                "sameAs": [
                    "https://github.com/kaischuygon",
                    "mailto:kai@kaischuyler.com"
                ],
                "jobTitle": "Software Engineer / Designer",
                "worksFor": {
                    "@type": "Organization",
                    "name": "zephy.dev"
                },
                "description": "Personal portfolio site of Kai Schuyler Gonzalez, a software engineer / designer based in Denver, CO."
            }
        </script>

        <!-- Favicon -->
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <meta name="theme-color" content="#737373" />

        <!-- RSS -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title={getTitle}
            href={new URL("rss.xml", Astro.site)}
        />

        <!-- Load preferred color scheme on load -->
        <script is:inline data-astro-rerun>
            const theme = localStorage.getItem("theme");

            if (
                theme === "dark" ||
                (!theme &&
                    window.matchMedia("(prefers-color-scheme: dark)").matches)
            ) {
                document.documentElement.classList.add("dark");
            }
        </script>

        <!-- Load saved accent color or daily -->
        <script is:inline data-astro-rerun define:vars={{ accentColors }}>
            const today = new Date();
            const dailyAccentColor =
                accentColors[today.getDate() % accentColors.length];
            // load the color from local storage, guarded for environments where it's unavailable
            let selected = null;
            try {
                selected = localStorage.getItem("accent");
            } catch (e) {
                selected = null;
            }

            // validate selected value against the known accentColors
            if (
                !selected ||
                selected === "daily" ||
                !accentColors.includes(selected)
            ) {
                // default to the computed daily accent
                document.documentElement.dataset["theme"] = dailyAccentColor;
            } else {
                document.documentElement.dataset["theme"] = selected;
            }
        </script>

        <!-- Load saved surface color or daily -->
        <script is:inline data-astro-rerun define:vars={{ surfaceColors }}>
            const surfaceToday = new Date();
            const dailySurfaceColor =
                surfaceColors[surfaceToday.getDate() % surfaceColors.length];
            // load the color from local storage, guarded for environments where it's unavailable
            let selectedSurface = null;
            try {
                selectedSurface = localStorage.getItem("surface");
            } catch (e) {
                selectedSurface = null;
            }

            // validate selected value against the known surfaceColors
            if (
                !selectedSurface ||
                selectedSurface === "daily" ||
                !surfaceColors.includes(selectedSurface)
            ) {
                // default to the computed daily surface
                document.documentElement.dataset["surface"] = dailySurfaceColor;
            } else {
                document.documentElement.dataset["surface"] = selectedSurface;
            }
        </script>

        <!-- All SEO goes here -->
        <SEO
            title={getTitle}
            titleTemplate={"%s | zephy.dev | " + author}
            titleDefault={"zephy.dev | " + author}
            description={getDescription}
            canonical="https://zephy.dev"
            openGraph={{
                basic: {
                    title: getTitle,
                    type: "website",
                    image: getImage,
                },
                optional: {
                    description: getDescription,
                },
                article: {
                    publishedTime: collectionItem?.data.pubDate?.toISOString(),
                    authors: [author],
                    tags:
                        collectionItem?.collection === "blog"
                            ? (collectionItem?.data?.categories ?? [])
                            : [],
                },
            }}
            twitter={{
                card: "summary",
                site: "zephy.dev",
                creator: "@kaischuyler",
                title: getTitle,
                description: getDescription,
                image: getImage,
                imageAlt:
                    collectionItem?.data.img_alt ??
                    "zephy.dev: Kai Schuyler Gonzalez's personal site and portfolio",
            }}
            extend={{
                // extending the default link tags
                link: [{ rel: "icon", href: "/favicon.ico" }],
            }}
        />
    </head>
    <body
        data-section={section}
        data-surface={section === "recipes" ? "taupe" : undefined}
    >
        <div
            class="container mx-auto grid h-screen grid-rows-[0fr_1fr_0fr] gap-4 p-2"
        >
            <nav class="flex flex-wrap items-center justify-end gap-2 text-sm">
                <SocialLinks />
                <div class="flex items-center justify-end gap-2 flex-wrap">
                    <ThemeSelect client:load />
                    <AccentSelect client:load />
                    <SurfaceSelect client:load locked={section === "recipes"} />
                    <label for="searchButton" class="clickable btn p-1">
                        <Icon
                            title="search"
                            name="lineicons:search-1"
                            class="inline"
                        />
                        <SearchModal />
                    </label>
                </div>
            </nav>
            <div
                class="mt-4 grid grid-cols-1 grid-rows-[0fr_1fr] gap-4 md:grid-cols-[auto_1fr] md:grid-rows-1"
            >
                <SideNav />
                <article>
                    <slot />
                </article>
            </div>
            <Footer />
        </div>
    </body>
</html>
