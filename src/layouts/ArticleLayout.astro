---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

interface Props {
    collectionItem: CollectionEntry<"blog" | "portfolio" | "recipes">;
    section?: "recipes";
    breadcrumbItems: { label: string; href?: string }[];
}

const { collectionItem, section, breadcrumbItems } = Astro.props as Props;
---

<Layout collectionItem={collectionItem} section={section}>
    <div class="flex flex-col gap-4 lg:flex-row">
        <section
            id={collectionItem.id}
            class="surface-prose grow"
            data-pagefind-body
        >
            <Breadcrumb items={breadcrumbItems} />
            <slot />
        </section>

        <aside
            id="related_more"
            class="flex w-full max-w-xs flex-col gap-2 lg:sticky lg:top-4 lg:ml-auto lg:h-min lg:max-h-[calc(100vh-1rem)] lg:w-md lg:overflow-y-auto"
        >
            <slot name="related" />
        </aside>
    </div>
</Layout>
